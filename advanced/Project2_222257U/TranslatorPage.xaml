<Page
    x:Class="Project2_222257U.TranslatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Project2_222257U"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <Grid Padding="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!--  Input Section  -->
        <StackPanel
            Grid.Column="0"
            Padding="20"
            VerticalAlignment="Center"
            Spacing="10">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Text="Select Language:" />
            <ComboBox Name="cmbLanguages" PlaceholderText="Select Language">
                <ComboBoxItem Content="French (fr)" />
                <ComboBoxItem Content="Spanish (es)" />
                <ComboBoxItem Content="German (de)" />
                <ComboBoxItem Content="Chinese (zh)" />
                <ComboBoxItem Content="Japanese (ja)" />
                <ComboBoxItem Content="Korean (ko)" />
                <ComboBoxItem Content="Italian (it)" />
                <ComboBoxItem Content="Russian (ru)" />
                <ComboBoxItem Content="Portuguese (pt)" />
                <ComboBoxItem Content="Dutch (nl)" />
            </ComboBox>
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Text="Enter text to translate:" />
            <TextBox
                Name="txtInput"
                Height="150"
                AcceptsReturn="True"
                BorderBrush="Gray"
                BorderThickness="2"
                PlaceholderText="Type text here..."
                TextWrapping="Wrap" />

            <Button
                Name="btnTranslate"
                Padding="10,5"
                Background="#0078D7"
                Click="btnTranslate_Click"
                Content="Translate"
                FontSize="16"
                FontWeight="Bold"
                Foreground="White" />
        </StackPanel>

        <!--  Output Section  -->
        <StackPanel
            Grid.Column="1"
            Padding="20"
            VerticalAlignment="Center"
            Spacing="10">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Text="Translation:" />
            <TextBox
                Name="txtOutput"
                Height="150"
                AcceptsReturn="True"
                BorderThickness="2"
                IsReadOnly="True"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>

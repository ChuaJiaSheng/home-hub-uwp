<Page
    x:Class="Project2_222257U.SketchingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Project2_222257U"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <Grid
        Width="Auto"
        ManipulationDelta="OnSwipe"
        ManipulationMode="TranslateX, TranslateY">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Margin="0,20,0,20"
            HorizontalAlignment="Center"
            FontSize="30"
            FontWeight="Bold"
            Foreground="Black"
            Text="Sketching" />

        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border
                Margin="5"
                Background="White"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Margin="10"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Name="btnDraw"
                            Click="btnDraw_Click"
                            Width="80"
                            Height="30"
                            Background="LightGreen"
                            Content="Draw" />
                        <Button
                            Name="btnErase"
                            Click="btnErase_Click"
                            Width="80"
                            Height="30"
                            Background="LightCoral"
                            Content="Erase" />
                        <Button
                            Name="btnSave"
                            Click="btnSave_Click"
                            Width="80"
                            Height="30"
                            Background="LightBlue"
                            Content="Save" />
                        <Button
                            Name="btnLoad"
                            Click="btnLoad_Click"
                            Width="80"
                            Height="30"
                            Background="LightBlue"
                            Content="Load" />
                        <ToggleButton
                            Name="tglEnable"
                            Click="tglEnable_Click"
                            Width="80"
                            Height="30"
                            Background="LightYellow"
                            Content="Enable" />
                    </StackPanel>
                    <Canvas
                        Name="CanvasSketch"
                        Grid.Row="1"
                        Background="WhiteSmoke"
                        PointerMoved="CanvasSketch_PointerMoved"
                        PointerPressed="CanvasSketch_PointerPressed"
                        PointerReleased="CanvasSketch_PointerReleased" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
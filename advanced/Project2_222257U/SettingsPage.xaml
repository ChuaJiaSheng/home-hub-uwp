<Page
    x:Class="Project2_222257U.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Project2_222257U"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Background="White">
            <StackPanel Margin="20" Spacing="20">

                <TextBlock
                    Margin="0,20,0,20"
                    FontSize="30"
                    FontWeight="Bold"
                    Text="Settings" />

                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="General" />
                <StackPanel Margin="0,0,0,20" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="Theme" />
                        <ComboBox Name="ThemeComboBox" Width="200">
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                            <ComboBoxItem Content="System Default" Tag="Default" />
                        </ComboBox>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="Language" />
                        <ComboBox
                            Name="LanguageComboBox"
                            Width="200"
                            SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="Chinese" Tag="zh" />
                            <ComboBoxItem Content="Spanish" Tag="es" />
                            <ComboBoxItem Content="French" Tag="fr" />
                            <ComboBoxItem Content="German" Tag="de" />
                            <ComboBoxItem Content="Japanese" Tag="ja" />
                            <ComboBoxItem Content="Korean" Tag="ko" />
                            <ComboBoxItem Content="Italian" Tag="it" />
                            <ComboBoxItem Content="Russian" Tag="ru" />
                            <ComboBoxItem Content="Portuguese" Tag="pt" />
                            <ComboBoxItem Content="Dutch" Tag="nl" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Notifications" />
                <StackPanel Margin="0,0,0,20" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="Enable Notifications" />
                        <ToggleSwitch Name="NotificationsToggle" Width="100" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="Sound" />
                        <ToggleSwitch Name="SoundToggle" Width="100" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Account" />
                <StackPanel Margin="0,0,0,20" Spacing="10">
                    <Button HorizontalAlignment="Left" Content="Change Password" />
                    <Button HorizontalAlignment="Left" Content="Manage Account" />
                </StackPanel>

                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="About" />
                <StackPanel Margin="0,0,0,20" Spacing="10">
                    <TextBlock Text="Version: 1.0.0" />
                    <TextBlock Text="© 2025 Project2_222257U" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<Page
    x:Class="Project1_222257U.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="Page_Loaded"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <SplitView
        Name="MySplitView"
        CompactPaneLength="45"
        DisplayMode="CompactOverlay"
        IsPaneOpen="False"
        OpenPaneLength="150">
        <SplitView.Pane>
            <Grid Background="Transparent">
                <StackPanel Padding="0,20,10,10">
                    <Button
                        Name="HamburgerButton"
                        Background="Transparent"
                        Click="HamburgerButton_Click">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="24"
                            Text="&#xE700;" />
                    </Button>

                    <Button
                        Name="MenuHome"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        Click="MenuHome_Click">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="24"
                                Text="&#xE10F;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="18"
                                Text="Home" />
                        </StackPanel>
                    </Button>

                    <Button
                        Name="MenuSketching"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        Click="MenuSketching_Click">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="24"
                                Text="&#xE790;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="18"
                                Text="Sketching" />
                        </StackPanel>
                    </Button>
                    <Button
                        Name="MenuAiChat"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        Click="MenuAiChat_Click">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Image
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Source="Images/AI.png" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="18"
                                Text="Ai Chat" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button
                    Name="MenuSettings"
                    Margin="0,10,0,0"
                    VerticalAlignment="Bottom"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    Click="MenuSettings_Click">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="24"
                            Text="&#xE713;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="18"
                            Text="Settings" />
                    </StackPanel>
                </Button>
            </Grid>
        </SplitView.Pane>

        <SplitView.Content>
            <Grid>
                <Frame Name="svFrame" />
            </Grid>
        </SplitView.Content>
    </SplitView>
</Page>

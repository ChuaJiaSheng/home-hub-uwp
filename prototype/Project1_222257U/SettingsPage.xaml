<Page
    x:Class="Project1_222257U.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Project1_222257U"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Background="White">
            <StackPanel Margin="20" Spacing="20">

                <TextBlock
                    Margin="0,20,0,20"
                    FontSize="30"
                    FontWeight="Bold"
                    Text="Settings" />

                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="General" />
                <StackPanel Margin="0,0,0,20" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="Theme" />
                        <ComboBox Name="ThemeComboBox" Width="200">
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="System Default" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="Language" />
                        <ComboBox Name="LanguageComboBox" Width="200">
                            <ComboBoxItem Content="English" />
                            <ComboBoxItem Content="Chinese" />
                            <ComboBoxItem Content="Spanish" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Notifications" />
                <StackPanel Margin="0,0,0,20" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="Enable Notifications" />
                        <ToggleSwitch Name="NotificationsToggle" Width="100" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="Sound" />
                        <ToggleSwitch Name="SoundToggle" Width="100" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Account" />
                <StackPanel Margin="0,0,0,20" Spacing="10">
                    <Button HorizontalAlignment="Left" Content="Change Password" />
                    <Button HorizontalAlignment="Left" Content="Manage Account" />
                </StackPanel>

                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="About" />
                <StackPanel Margin="0,0,0,20" Spacing="10">
                    <TextBlock Text="Version: 1.0.0" />
                    <TextBlock Text="© 2024 Project1_222257U" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<Page
    x:Class="Project1_222257U.AIChat"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Project1_222257U"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="Page_Loaded"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <Grid
        Padding="30"
        ManipulationDelta="OnSwipe"
        ManipulationMode="TranslateX, TranslateY">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Margin="0,20,0,20"
            HorizontalAlignment="Center"
            FontSize="30"
            FontWeight="Bold"
            Foreground="Black"
            Text="AI ChatGPT" />

        <Border
            Grid.Row="1"
            Background="WhiteSmoke"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    Grid.Row="0"
                    Margin="10"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <StackPanel>
                            <Border
                                Padding="10"
                                HorizontalAlignment="Right"
                                Background="LightBlue"
                                CornerRadius="15">
                                <TextBlock Foreground="Black" Text="User: What's the weather like today?" />
                            </Border>
                        </StackPanel>
                        <StackPanel>
                            <Border
                                Padding="10"
                                HorizontalAlignment="Left"
                                Background="LightGreen"
                                CornerRadius="15">
                                <TextBlock Foreground="Black" Text="AI: It's sunny with a high of 25°C." />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel
                    Grid.Row="1"
                    Margin="10,0,10,10"
                    HorizontalAlignment="Stretch"
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBox
                        Name="txtChat"
                        Width="Auto"
                        Height="40"
                        Padding="10"
                        VerticalContentAlignment="Center"
                        Background="White"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="10"
                        KeyDown="txtChat_KeyDown"
                        PlaceholderText="Enter your query..." />
                 
                    <Button
                        Name="btnSend"
                        Width="80"
                        Height="40"
                        VerticalAlignment="Center"
                        Background="LightBlue"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        Click="btnSend_Click"
                        Content="Send"
                        CornerRadius="10" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
